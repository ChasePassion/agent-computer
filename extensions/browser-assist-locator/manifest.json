{
  "manifest_version": 3,
  "name": "Browser Assist Locator",
  "version": "0.1.0",
  "description": "Read-only browser locator bridge for agent-computer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Browser Assist Locator"
  }
}
