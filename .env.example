# Core daemon settings
AGENT_COMPUTER_HOST=127.0.0.1
AGENT_COMPUTER_PORT=37688

# Public observation/live base URL
AGENT_COMPUTER_OBSERVATION_PUBLIC_BASE_URL=http://your-public-host

# Shared relay / tunnel settings
AGENT_COMPUTER_RELAY_HOST=your-relay-host
AGENT_COMPUTER_RELAY_USER=your-relay-user
AGENT_COMPUTER_RELAY_PASSWORD=your-relay-password
AGENT_COMPUTER_RELAY_SSH_PORT=22
AGENT_COMPUTER_RELAY_PORT=43768

# Optional local override for the reverse tunnel target
AGENT_COMPUTER_LOCAL_HOST=127.0.0.1
AGENT_COMPUTER_LOCAL_PORT=37688
